{
  "about": "Expected KB sections, not confirmed vulnerabilities. Original service rows keep their starter expected values for Part 5. final_expected records knowledge additions. A wrong extra section counts as wrong_version even if the right section also appears.",
  "services": [
    {
      "host": "10.0.0.5",
      "service": "vsftpd 2.3.4",
      "expected": "vsftpd 2.3.4",
      "final_expected": "vsftpd 2.3.4",
      "stage": "starter"
    },
    {
      "host": "10.0.0.5",
      "service": "OpenSSH 7.2p2 Ubuntu",
      "expected": "OpenSSH 7.2p2",
      "final_expected": "OpenSSH 7.2p2",
      "stage": "starter"
    },
    {
      "host": "10.0.0.5",
      "service": "Apache httpd 2.4.49",
      "expected": "Apache httpd 2.4.49",
      "final_expected": "Apache httpd 2.4.49",
      "stage": "starter"
    },
    {
      "host": "10.0.0.8",
      "service": "Samba smbd 3.5.0",
      "expected": "Samba 3.5.0",
      "final_expected": "Samba 3.5.0",
      "stage": "starter"
    },
    {
      "host": "10.0.0.8",
      "service": "MySQL 5.5.40",
      "expected": "MySQL 5.5",
      "final_expected": "MySQL 5.5",
      "stage": "starter"
    },
    {
      "host": "10.0.0.12",
      "service": "Linux telnetd",
      "expected": "Telnet service",
      "final_expected": "Telnet service",
      "stage": "starter"
    },
    {
      "host": "10.0.0.12",
      "service": "Apache httpd 2.2.8 (OpenSSL 1.0.1)",
      "expected": "OpenSSL 1.0.1",
      "note": "expected the OpenSSL 1.0.1 advisory. must_not: this host runs Apache 2.2.8, so an answer that also drags in the 2.4.49 advisory is reporting a vulnerability that is not there -- count that as a wrong-version answer even though the right one is in it.",
      "must_not": [
        "Apache httpd 2.4.49"
      ],
      "final_expected": "OpenSSL 1.0.1",
      "stage": "starter"
    },
    {
      "host": "10.0.0.12",
      "service": "Redis key-value store 4.0.9",
      "expected": "Redis 4.0",
      "final_expected": "Redis 4.0",
      "stage": "starter"
    },
    {
      "host": "10.0.0.20",
      "service": "ProFTPD 1.3.5",
      "expected": "ProFTPD 1.3.5",
      "final_expected": "ProFTPD 1.3.5",
      "stage": "starter"
    },
    {
      "host": "10.0.0.20",
      "service": "nginx 1.18.0",
      "expected": null,
      "note": "a true blind spot: the KB has no nginx entry",
      "final_expected": "nginx 1.18.0",
      "stage": "starter"
    },
    {
      "host": "10.0.0.20",
      "service": "PostgreSQL 9.6.24",
      "expected": null,
      "note": "a true blind spot: the KB has no PostgreSQL entry",
      "final_expected": "PostgreSQL 9.6.24",
      "stage": "starter"
    },
    {
      "host": "10.0.0.30",
      "service": "OpenSSH 7.2p2 Ubuntu",
      "expected": "OpenSSH 7.2p2",
      "final_expected": "OpenSSH 7.2p2",
      "stage": "custom"
    },
    {
      "host": "10.0.0.30",
      "service": "nginx 1.24.0",
      "expected": null,
      "final_expected": "nginx 1.24.0",
      "stage": "custom",
      "must_not": [
        "nginx 1.18.0",
        "nginx"
      ]
    },
    {
      "host": "10.0.0.30",
      "service": "Apache httpd 2.4.50",
      "expected": null,
      "final_expected": "Apache httpd 2.4.50",
      "stage": "custom",
      "must_not": [
        "Apache httpd 2.4.49"
      ]
    }
  ],
  "policy": {
    "host": "10.0.0.30",
    "allowed_tcp_ports": [
      22,
      443
    ],
    "expected_by_port": {
      "22": "allowed",
      "80": "review_required",
      "8080": "review_required"
    }
  }
}
